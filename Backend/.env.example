# Copy to Backend/.env — never commit .env

# Server
PORT=3001
NODE_ENV=development
# Comma-separated frontend URLs for CORS (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Auth — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret

# PostgreSQL (local)
PGUSER=postgres
PGHOST=localhost
PGDATABASE=ims_db
PGPASSWORD=postgres
PGPORT=5432

# PostgreSQL (hosted — Neon, Render, Railway, Supabase)
# Use DATABASE_URL instead of PG* vars when deploying
# DATABASE_URL=postgresql://user:pass@host:5432/ims_db?sslmode=require
# PGSSL=true

# Google Gemini — AI chat
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Razorpay (live payments)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Optional: public frontend URL for emails
# FRONTEND_PUBLIC_URL=https://your-app.netlify.app
